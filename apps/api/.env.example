# Supabase: Project Settings -> Database -> Connection string (puerto 5432 o 6543)
DATABASE_URL="postgresql://postgres.REFERENCIA:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# Supabase usa una CA propia; desactivar solo si no se configura la CA del proyecto.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
PORT=8000
JWT_SECRET="genera-un-secret-largo-y-aleatorio"
SEED_USUARIO="contable"
SEED_PASSWORD="cambiar-esta-clave"
SEED_NOMBRE="Administrador"
SEED_APELLIDO="Contable"
# Supabase Storage (opcional en desarrollo; sin clave usa apps/api/uploads)
# SUPABASE_URL="https://REFERENCIA.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="service-role-key"
# SUPABASE_STORAGE_BUCKET="documentos"
